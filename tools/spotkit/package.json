{
  "name": "@hubspotlab/spotkit",
  "version": "0.6.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathias7799/HubSpotLab.git",
    "directory": "tools/spotkit"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "spotkit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "runtime",
    "templates",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/sync-runtime.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm test && pnpm typecheck",
    "start": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
