{
  "name": "@hubspotlab/spotkit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "bin": {
    "spotkit": "dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
