HUBSPOT_CLIENT_ID=your-development-app-client-id
HUBSPOT_CLIENT_SECRET=your-development-app-client-secret
PUBLIC_URL=http://localhost:8799
PORT=8799
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-local-value
ALLOW_UNSIGNED_DEVELOPMENT_REQUESTS=true
# Optional locally; required in production:
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-me
