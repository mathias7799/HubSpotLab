{
  "uid": "handoffready_app",
  "type": "app",
  "config": {
    "description": "Prepare complete department handoffs and create linked HubSpot tickets, tasks, or projects with task plans.",
    "name": "HandoffReady",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": ["https://handoffready.example.com/oauth/callback"],
      "requiredScopes": [
        "oauth",
        "crm.objects.deals.read",
        "crm.objects.contacts.write",
        "crm.objects.projects.read",
        "crm.objects.projects.write",
        "crm.objects.owners.read",
        "crm.schemas.custom.read",
        "crm.objects.custom.read",
        "crm.objects.custom.write",
        "settings.users.read",
        "tickets"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": ["https://handoffready.example.com"],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://github.com/mathias7799/HubSpotLab/tree/main/projects/handoffready",
      "supportUrl": "https://github.com/mathias7799/HubSpotLab/issues"
    }
  }
}
