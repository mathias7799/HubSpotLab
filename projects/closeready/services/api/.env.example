HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Add crm.schemas.custom.read and crm.objects.custom.read/write for native mode.
HUBSPOT_SCOPES=oauth crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read crm.objects.companies.read
PUBLIC_URL=https://closeready.example.com
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# auto prefers the HubSpot object and falls back to the encrypted portable store.
RULE_STORAGE=auto
PORT=8788
ALLOW_UNSIGNED_DEVELOPMENT_REQUESTS=false
