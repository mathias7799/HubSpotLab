{
  "name": "@hubspotlab/closeready",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "core:test": "pnpm --filter @hubspotlab/closeready-core test",
    "core:typecheck": "pnpm --filter @hubspotlab/closeready-core typecheck",
    "api:test": "pnpm --filter @hubspotlab/closeready-api test",
    "api:typecheck": "pnpm --filter @hubspotlab/closeready-api typecheck",
    "app:test": "pnpm --dir apps/hubspot/src/app/pages test",
    "app:typecheck": "pnpm --dir apps/hubspot/src/app/pages typecheck && pnpm --dir apps/hubspot/src/app/settings typecheck",
    "test": "pnpm --filter './packages/**' --filter './services/**' test && pnpm app:test",
    "typecheck": "pnpm --filter './packages/**' --filter './services/**' typecheck && pnpm app:typecheck"
  }
}
