{
  "name": "hubspot-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "spotkit": "pnpm --filter @hubspotlab/spotkit start",
    "spotkit:test": "pnpm --filter @hubspotlab/spotkit test",
    "skills:validate": "node tools/validate-skills.mjs",
    "tidshub:api:dev": "pnpm --dir projects/tidshub api:dev",
    "tidshub:api:local": "pnpm --dir projects/tidshub api:local",
    "tidshub:validate": "pnpm --dir projects/tidshub validate",
    "tidshub:upload": "pnpm --dir projects/tidshub upload"
  },
  "devDependencies": {
    "@hubspot/cli": "8.9.1",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
